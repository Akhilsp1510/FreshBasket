# ==============================================================================
# FreshBasket Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Replace the placeholder values below with your real local or AWS credentials.
# 3. NEVER commit your actual '.env' file to Git or version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django Settings
# ------------------------------------------------------------------------------
SECRET_KEY=your-django-secret-key-replace-with-a-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL / Amazon RDS)
# ------------------------------------------------------------------------------
# Set DB_ENGINE=mysql for local MySQL / Amazon RDS, or 'sqlite' for quick local dev
DB_ENGINE=mysql
DB_NAME=freshbasket_db
DB_USER=freshbasket_user
DB_PASSWORD=your_secure_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to True when connected to an Amazon RDS MySQL instance in production
USE_RDS=False

# ------------------------------------------------------------------------------
# 3. Amazon Web Services (AWS) Storage Settings (Optional for Local Dev)
# ------------------------------------------------------------------------------
# Set USE_S3=True to store media uploads on Amazon S3 instead of local disk
USE_S3=False
# Note: On EC2 with FreshBasketEC2Role, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# blank/commented out so boto3 uses the IAM Instance Profile automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=freshbasket-media-yourname
AWS_S3_REGION_NAME=ap-south-1
# Optional: Set CloudFront distribution domain if using CDN for image delivery
AWS_CLOUDFRONT_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Production Security & SSL Settings (Used when DEBUG=False)
# ------------------------------------------------------------------------------
# Set to True in production when SSL/TLS is enabled on ALB / CloudFront / Domain
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 5. Email Notification Settings (Optional)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password
